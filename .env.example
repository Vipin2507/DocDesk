# SQLite database file. Relative paths are resolved from the project root.
DATABASE_URL=file:./data/document-studio.db

# Directory for uploads, generated PDFs, and temporary conversion files.
# DATA_DIR=./data

# Cookie session signing material. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Set true only when the app is served over HTTPS.
# COOKIE_SECURE=false

PORT=8787
NODE_ENV=development

# First administrator, created only when the users table is empty.
# ADMIN_EMAIL=admin@buildesk.local
# ADMIN_PASSWORD=

# Comma-separated browser origins allowed to call the API with cookies.
# Defaults to the Vite dev server.
# CLIENT_ORIGIN=http://localhost:5173

# AI providers are optional. Keys stay on the server and are never sent to the browser.
# DOCUMENT_AI_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_MAX_PAGES=4

# Upload limits
# MAX_UPLOAD_BYTES=20971520
# MAX_PDF_PAGES=50
